{
  "project": "jaffle-semantic",
  "manifestVersion": 3,
  "modeling": {
    "mode": "dbt-first"
  },
  "dbt": {
    "projectDir": ".",
    "manifestPath": "target/manifest.json"
  },
  "connections": {
    "default": {
      "driver": "duckdb",
      "filepath": ":memory:"
    }
  },
  "governance": {
    "required_fields": [
      "domain",
      "owner",
      "description"
    ]
  },
  "semanticLayer": {
    "provider": "dbt",
    "projectPath": "."
  }
}
