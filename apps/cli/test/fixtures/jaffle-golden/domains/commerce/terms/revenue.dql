// dql-format: 1

term "Revenue" {
  domain = "commerce"
  type = "metric"
  status = "certified"
  description = "Gross money paid for Jaffle Shop orders, including tax when the orders mart is used. Product revenue from order_items excludes tax."
  owner = "analytics@jaffle.shop"
  tags = ["metric", "commerce"]
  synonyms = ["sales", "gross revenue"]
  businessOwner = "Jaffle Shop Growth Team"
  businessRules = ["Use dev.orders.order_total for gross order revenue.", "Use dev.order_items.product_price for product and beverage revenue."]
  caveats = ["Order revenue and product revenue use different grains and tax treatment; do not mix them without stating the measure."]
}
