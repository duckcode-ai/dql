// dql-format: 1

block "monthly_revenue" {
  domain = "commerce"
  type = "custom"
  status = "certified"
  description = "Monthly gross order revenue and order count. One row per calendar month."
  owner = "analytics@jaffle.shop"
  tags = ["revenue", "trend", "growth"]
  pattern = "trend"
  grain = "one row per calendar month"
  entities = ["order"]
  terms = ["Revenue", "Order"]
  outputs = ["month", "gross_revenue", "order_count"]
  dimensions = ["month"]
  allowedFilters = []
  sourceSystems = ["dbt:orders"]
  replacementFor = []
  reviewCadence = "monthly"
  llmContext = "Use for revenue trends by month. Gross revenue is SUM(dev.orders.order_total), including tax; the result also contains the number of orders."
  examples = [
    { question = "How has revenue changed by month?" },
    { question = "Show monthly gross revenue and orders." }
  ]

  query = """
    SELECT
      date_trunc('month', ordered_at) AS month,
      SUM(order_total) AS gross_revenue,
      COUNT(*) AS order_count
    FROM dev.orders
    GROUP BY 1
    ORDER BY 1
  """

  visualization {
    chart = "line"
  }

  tests {
    assert row_count > 0
  }
}
