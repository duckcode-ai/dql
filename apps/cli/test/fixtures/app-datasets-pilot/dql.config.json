{
  "project": "app-datasets-pilot",
  "manifestVersion": 3,
  "modeling": {
    "mode": "dbt-first"
  },
  "apps": {
    "datasets": true
  },
  "connections": {
    "default": {
      "driver": "duckdb",
      "filepath": "app-datasets-pilot.duckdb"
    }
  },
  "semanticLayer": {
    "provider": "dql",
    "path": "semantic-layer"
  },
  "dbt": {
    "projectDir": ".",
    "manifestPath": "target/manifest.json"
  }
}
