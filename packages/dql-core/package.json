{
  "name": "@duckcodeailabs/dql-core",
  "version": "1.17.3",
  "description": "DQL language core: lexer, parser, AST, semantic analysis",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./lineage": {
      "types": "./dist/lineage/index.d.ts",
      "import": "./dist/lineage/index.js"
    },
    "./lineage/derivation": {
      "types": "./dist/lineage/derivation.d.ts",
      "import": "./dist/lineage/derivation.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./apps/tile-query": {
      "types": "./dist/apps/tile-query.d.ts",
      "import": "./dist/apps/tile-query.js"
    },
    "./apps/viz-style": {
      "types": "./dist/apps/viz-style.d.ts",
      "import": "./dist/apps/viz-style.js"
    },
    "./apps/grid-layout": {
      "types": "./dist/apps/grid-layout.d.ts",
      "import": "./dist/apps/grid-layout.js"
    },
    "./datasets/descriptor": {
      "types": "./dist/datasets/descriptor.d.ts",
      "import": "./dist/datasets/descriptor.js"
    },
    "./datasets/aggregate-expression": {
      "types": "./dist/datasets/aggregate-expression.d.ts",
      "import": "./dist/datasets/aggregate-expression.js"
    },
    "./datasets/aggregate-expression.node": {
      "types": "./dist/datasets/aggregate-expression.node.d.ts",
      "import": "./dist/datasets/aggregate-expression.node.js"
    },
    "./datasets/component-proof.node": {
      "types": "./dist/datasets/component-proof.node.d.ts",
      "import": "./dist/datasets/component-proof.node.js"
    },
    "./datasets/source-authoring.node": {
      "types": "./dist/datasets/source-authoring.node.d.ts",
      "import": "./dist/datasets/source-authoring.node.js"
    },
    "./modeling-ids": {
      "types": "./dist/manifest/model-area-id.d.ts",
      "import": "./dist/manifest/model-area-id.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dql",
    "dashboard",
    "query",
    "language",
    "lexer",
    "parser",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai/dql.git",
    "directory": "packages/dql-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "node-sql-parser": "^5.4.0"
  }
}
